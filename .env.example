# ===== 平台（代理开放接口）=====
# 平台根地址，不要带 /api/agent/open/v1 前缀
PLATFORM_API_BASE=https://api.example.com
# 在平台代理控制台 /agent/open-api 创建的 Key，agk_ 开头
PLATFORM_AGENT_API_KEY=agk_xxxxxxxxxxxxxxxx
# 普通接口超时（秒）
PLATFORM_TIMEOUT_SECONDS=15
# 等待支付接口超时（秒），必须大于平台的 120 秒同步等待上限
PLATFORM_WAIT_TIMEOUT_SECONDS=150
# 是否校验平台 HTTPS 证书
PLATFORM_VERIFY_SSL=true

# ===== 本服务 =====
# Agent 框架调用本服务时携带的 X-Service-Token，逗号分隔可配置多个
SERVICE_API_TOKENS=change-me-to-a-long-random-string
# 仅本地调试时可设为 true 以跳过令牌校验，生产环境禁止
SERVICE_AUTH_DISABLED=false
LOG_LEVEL=INFO
